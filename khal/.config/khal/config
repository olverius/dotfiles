# khal — minimal terminal calendar (events synced from Google by vdirsyncer)

[calendars]
[[google]]
path = ~/.local/share/calendars/*
type = discover

[locale]
timeformat = %H:%M
dateformat = %d.%m.
longdateformat = %d.%m.%Y
datetimeformat = %d.%m. %H:%M
longdatetimeformat = %d.%m.%Y %H:%M
firstweekday = 0

[default]
highlight_event_days = True
timedelta = 7d

[view]
theme = dark
frame = color
