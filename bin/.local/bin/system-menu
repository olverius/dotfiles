#!/usr/bin/env bash
# power-menu — lock / suspend / log out / reboot / shut down, picked in fuzzel.
# Bound to the power button and Super+Escape in hyprland.lua.

choice=$(printf '%s\n' \
    "󰌾  Lock" \
    "󰤄  Suspend" \
    "󰍃  Log out" \
    "󰜉  Reboot" \
    "󰐥  Shut down" \
  | fuzzel --dmenu --prompt "power › " --lines 5 --width 22)

case "$choice" in
    *Lock)      hyprlock ;;
    *Suspend)   systemctl suspend ;;
    *"Log out") hyprctl dispatch 'hl.dsp.exit()' ;;
    *Reboot)    systemctl reboot ;;
    *"Shut down") systemctl poweroff ;;
esac
