#!/usr/bin/env bash
# music-ws — open workspace 4 in a fixed order: cliamp (left), cava (top right), clock (bottom right).
# Waits until each window really exists before opening the next, so a slow boot can't shuffle them.

wait_for() {   # wait up to 10 s for a window with this class
    for _ in $(seq 100); do
        hyprctl clients | grep -q "class: $1\$" && return 0
        sleep 0.1
    done
}

# If cliamp isn't running, remove leftovers from a crashed session —
# otherwise a new cliamp may think one is already running and quit.
if ! pgrep -x cliamp > /dev/null; then
    rm -f "$HOME/.config/cliamp/cliamp.sock" "$HOME/.config/cliamp/cliamp.sock.pid"
fi

kitty --class cliamp -e cliamp &
wait_for cliamp
kitty --class cava -e cava &
wait_for cava
kitty --class clock -e tty-clock -c -s -C 3 &
