#!/usr/bin/env bash
# music-ws — open workspace 4 in a fixed order: cliamp (left), cava (top right), clock (bottom right).
# Waits until each window really exists before opening the next, so a slow boot can't shuffle them.

ERRLOG="$HOME/.cache/cliamp-start.log"

has_window() { hyprctl clients | grep -q "class: $1\$"; }

wait_for() {   # wait up to 10 s for a window with this class
    for _ in $(seq 100); do
        has_window "$1" && return 0
        sleep 0.1
    done
    return 1
}

# Right after login PipeWire may not be ready yet, and cliamp quits without audio.
# Wait (max 15 s) until there is a default output device.
for _ in $(seq 30); do
    wpctl inspect @DEFAULT_AUDIO_SINK@ > /dev/null 2>&1 && break
    sleep 0.5
done

# If cliamp isn't running, remove leftovers from a crashed session —
# otherwise a new cliamp may think one is already running and quit.
if ! pgrep -x cliamp > /dev/null; then
    rm -f "$HOME/.config/cliamp/cliamp.sock" "$HOME/.config/cliamp/cliamp.sock.pid"
fi

start_cliamp() {
    # errors go to ~/.cache/cliamp-start.log so we can see why it quit
    kitty --class cliamp -e sh -c "echo \"--- \$(date)\" >> '$ERRLOG'; cliamp 2>> '$ERRLOG'" &
    wait_for cliamp
}

# Start cliamp; if its window is gone again after 3 s, wait a bit and try once more.
start_cliamp
sleep 3
if ! has_window cliamp; then
    sleep 3
    rm -f "$HOME/.config/cliamp/cliamp.sock" "$HOME/.config/cliamp/cliamp.sock.pid"
    start_cliamp
fi

kitty --class cava -e cava &
wait_for cava
kitty --class clock -e tty-clock -c -s -C 3 &
