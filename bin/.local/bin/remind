#!/usr/bin/env bash
# remind — two-step reminder: first what, then when
# "when": a number of minutes (e.g. 20), or 1h30m, 45s, or a clock time like 18:30

msg=$(fuzzel --dmenu --prompt "remind me to › " --lines 0 --width 40 < /dev/null)
[ -z "$msg" ] && exit 0

when=$(fuzzel --dmenu --prompt "in how many minutes › " --lines 0 --width 40 < /dev/null)
when=${when// /}
[ -z "$when" ] && exit 0

if [[ $when =~ ^[0-9]+$ ]]; then
    # plain number = minutes
    delay="${when}m"
    label="in $when min"
elif [[ $when =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
    # clock time: today, or tomorrow if it has already passed
    now=$(date +%s)
    target=$(date -d "$when" +%s) || exit 1
    [ "$target" -le "$now" ] && target=$((target + 86400))
    delay="$((target - now))s"
    label="at $when"
elif [[ $when =~ ^([0-9]+[hms])+$ ]]; then
    delay=$when
    label="in $when"
else
    notify-send "Reminder" "Couldn't read the time \"$when\" — use e.g. 20m, 1h30m or 18:30"
    exit 1
fi

systemd-run --user --quiet --on-active="$delay" --timer-property=AccuracySec=1s \
    notify-send -u critical -t 60000 -a Reminder "󰂞  Reminder" "$msg"

notify-send "Reminder set" "$msg — $label"
