#!/usr/bin/env python3
"""nextevent — waybar module: your next calendar event (from khal), today's agenda on hover."""
import datetime as dt, html, json, subprocess

ICON = "󰃭"

def khal(*args):
    try:
        out = subprocess.run(["khal", "list", *args], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return []
    return [l for l in out.splitlines() if l.strip()]

def parse(line):
    try:
        date_s, time_s, title = line.split("|", 2)
        day = dt.datetime.strptime(date_s.strip(), "%d.%m.%Y").date()
        return day, time_s.strip(), title.strip()
    except ValueError:
        return None

FMT = "{start-date-long}|{start-time}|{title}"
now = dt.datetime.now()
today = now.date()

# next timed event in the coming week (all-day events like holidays are skipped)
upcoming = [p for p in (parse(l) for l in khal("now", "7d", "--format", FMT, "--day-format", "")) if p and p[1]]
nxt = None
for day, t, title in upcoming:
    if day == today and dt.datetime.combine(day, dt.datetime.strptime(t, "%H:%M").time()) < now - dt.timedelta(minutes=1):
        continue    # already started earlier today
    nxt = (day, t, title)
    break

# today's agenda for the tooltip
agenda = [p for p in (parse(l) for l in khal("today", "today", "--format", FMT, "--day-format", "")) if p]
tip_lines = [f"{t or 'all day':>7}  {html.escape(title)}" for _, t, title in agenda] or ["nothing today"]
tooltip = "<b>Today</b>\n" + "\n".join(tip_lines) + "\n\nclick: open calendar"

if nxt:
    day, t, title = nxt
    if day == today:   when = t
    else:              when = f"{day.strftime('%a')} {t}"
    label = "today" if day == today else ("tomorrow" if day == today + dt.timedelta(days=1) else day.strftime("%A"))
    tooltip = f"<b>Next:</b> {label} {t}  {html.escape(title)}\n\n" + tooltip
    text, cls = f"{ICON}  {when}", ("today" if day == today else "later")
else:
    text, cls = ICON, "none"

print(json.dumps({"text": text, "tooltip": tooltip, "class": cls}))
