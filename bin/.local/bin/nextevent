#!/usr/bin/env python3
"""nextevent — waybar module: icon + time of your next event (from khal),
agenda for the coming days on hover."""
import datetime as dt, html, json, subprocess

ICON = "󰃭"
DAYS = 7          # how many days the hover agenda covers

def khal(*args):
    try:
        out = subprocess.run(["khal", "list", *args], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return []
    return [l for l in out.splitlines() if l.strip()]

def parse(line):
    try:
        date_s, time_s, title = line.split("|", 2)
        day = dt.datetime.strptime(date_s.strip(), "%d.%m.%Y").date()
        return day, time_s.strip(), title.strip()
    except ValueError:
        return None

FMT = "{start-date-long}|{start-time}|{title}"
now = dt.datetime.now()
today = now.date()

events = [p for p in (parse(l) for l in khal("today", f"{DAYS}d", "--format", FMT, "--day-format", "")) if p]

def started(day, t):
    return day == today and t and dt.datetime.combine(day, dt.datetime.strptime(t, "%H:%M").time()) < now - dt.timedelta(minutes=1)

# next timed event that hasn't started yet (all-day events are skipped)
nxt = next(((d, t, title) for d, t, title in events if t and not started(d, t)), None)

def day_label(d):
    if d == today: return "Today"
    if d == today + dt.timedelta(days=1): return "Tomorrow"
    return d.strftime("%a %d.%m")

# hover agenda: grouped by day, past events from today left out
lines, cur = [], None
for d, t, title in events:
    if started(d, t):
        continue
    if d != cur:
        if lines: lines.append("")
        lines.append(f"<b>{day_label(d)}</b>")
        cur = d
    lines.append(f"{t or 'all day':>7}  {html.escape(title)}")
tooltip = "\n".join(lines or [f"nothing in the next {DAYS} days"]) + "\n\nclick: open calendar"

if nxt:
    d, t, _ = nxt
    when = t if d == today else f"{d.strftime('%a')} {t}"
    text, cls = f"{ICON}  {when}", ("today" if d == today else "later")
else:
    text, cls = ICON, "none"

print(json.dumps({"text": text, "tooltip": tooltip, "class": cls}))
