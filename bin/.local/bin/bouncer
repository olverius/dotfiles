   <span foreground="#c9925f">████████████</span>     
  <span foreground="#c9925f">█</span><span foreground="#1d2021">█</span><span foreground="#1d2021" background="#7c6f64">▀</span><span foreground="#1d2021">██</span><span foreground="#1d2021" background="#c9925f">▀▀▀▀</span><span foreground="#1d2021">█</span><span foreground="#1d2021" background="#7c6f64">▀</span><span foreground="#1d2021">██</span><span foreground="#c9925f" background="#7daea3">▀</span>    
   <span foreground="#c9925f">█</span><span foreground="#1d2021" background="#c9925f">▀▀▀</span><span foreground="#c9925f">█</span><span foreground="#c9925f" background="#a87548">▀▀</span><span foreground="#c9925f">█</span><span foreground="#1d2021" background="#c9925f">▀▀▀</span><span foreground="#c9925f">█</span><span foreground="#7daea3">█</span>    
