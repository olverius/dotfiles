 <span foreground="#45403d">█</span><span foreground="#45403d" background="#5d5550">▀▀▀▀▀▀▀</span><span foreground="#ea6962" background="#5d5550">▀▀</span><span foreground="#45403d" background="#5d5550">▀▀▀▀▀▀▀</span><span foreground="#45403d">█</span> 
 <span foreground="#45403d">█</span><span foreground="#5d5550">█</span><span foreground="#45403d" background="#c9925f">▀▀</span><span foreground="#45403d">██████████</span><span foreground="#c9925f" background="#45403d">▀▀</span><span foreground="#5d5550">█</span><span foreground="#45403d">█</span> 
 <span foreground="#45403d">█</span><span foreground="#5d5550" background="#45403d">▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀</span><span foreground="#45403d">█</span> 
