#!/usr/bin/env bash
# bouncer — pixel-art bodyguard for hyprlock. Arms crossed; shakes his head after a wrong password.
# Called by a hyprlock label:  text = cmd[update:120] $HOME/.local/bin/bouncer $ATTEMPTS
# Drawn with half-block characters, each colored with Pango markup (2 pixels per character).

n=${1:-0}; [[ $n =~ ^[0-9]+$ ]] || n=0
state="${XDG_RUNTIME_DIR:-/tmp}/bouncer.state"
now=$(( $(date +%s%N) / 1000000 ))

read -r last t 2>/dev/null < "$state" || { last=0; t=0; }
(( n > last )) && t=$now
(( n != last )) && echo "$n $t" > "$state"

SHAKE_MS=1400
STEP_MS=140
elapsed=$(( now - t ))

if (( n > 0 && elapsed < SHAKE_MS )); then
    if (( (elapsed / STEP_MS) % 2 )); then
        cat << 'ART'
      <span foreground="#c9925f">▄▄██████▄▄</span>    
     <span foreground="#c9925f">████████████</span>   
    <span foreground="#c9925f">█</span><span foreground="#1d2021">█</span><span foreground="#1d2021" background="#7c6f64">▀</span><span foreground="#1d2021">██</span><span foreground="#1d2021" background="#c9925f">▀▀▀▀</span><span foreground="#1d2021">█</span><span foreground="#1d2021" background="#7c6f64">▀</span><span foreground="#1d2021">██</span><span foreground="#c9925f" background="#7daea3">▀</span>  
     <span foreground="#c9925f">█</span><span foreground="#1d2021" background="#c9925f">▀▀▀</span><span foreground="#c9925f">█</span><span foreground="#c9925f" background="#a87548">▀▀</span><span foreground="#c9925f">█</span><span foreground="#1d2021" background="#c9925f">▀▀▀</span><span foreground="#c9925f">█</span><span foreground="#7daea3">█</span>  
     <span foreground="#c9925f">███</span><span foreground="#c9925f" background="#6b4a2f">▀</span><span foreground="#6b4a2f" background="#c9925f">▀▀▀▀</span><span foreground="#c9925f" background="#6b4a2f">▀</span><span foreground="#c9925f">██</span><span foreground="#c9925f" background="#7daea3">▀</span><span foreground="#7daea3">▀</span>  
      <span foreground="#c9925f">▀███████</span><span foreground="#c9925f" background="#7daea3">▀</span><span foreground="#7daea3">▀</span>    
   <span foreground="#45403d">▄▄▄▄</span><span foreground="#c9925f" background="#45403d">▀</span><span foreground="#c9925f" background="#d4be98">▀▀▀▀</span><span foreground="#c9925f" background="#45403d">▀</span><span foreground="#45403d">▄▄▄▄</span>   
 <span foreground="#45403d">▄██████</span><span foreground="#d4be98" background="#45403d">▀</span><span foreground="#ea6962">██</span><span foreground="#d4be98" background="#45403d">▀</span><span foreground="#45403d">██████▄</span> 
 <span foreground="#45403d">█</span><span foreground="#45403d" background="#5d5550">▀▀▀▀▀▀▀</span><span foreground="#ea6962" background="#5d5550">▀▀</span><span foreground="#45403d" background="#5d5550">▀▀▀▀▀▀▀</span><span foreground="#45403d">█</span> 
 <span foreground="#45403d">█</span><span foreground="#5d5550">█</span><span foreground="#45403d" background="#c9925f">▀▀</span><span foreground="#45403d">██████████</span><span foreground="#c9925f" background="#45403d">▀▀</span><span foreground="#5d5550">█</span><span foreground="#45403d">█</span> 
 <span foreground="#45403d">█</span><span foreground="#5d5550" background="#45403d">▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀</span><span foreground="#45403d">█</span> 
 <span foreground="#45403d">▀████████████████▀</span> 
       <span foreground="#ea6962">nope.</span>
ART
    else
        cat << 'ART'
