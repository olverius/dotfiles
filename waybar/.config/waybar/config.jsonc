// Waybar — minimal, Gruvbox Material (Nerd Font icons)
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "custom/media", "custom/media-next"],
    "modules-center": ["clock", "custom/pomo"],
    "modules-right": ["custom/nextevent", "custom/remind", "tray","backlight", "backlight/slider", "pulseaudio", "battery"],

    "hyprland/workspaces": {
        "format": "{id}"
    },
    "custom/media": {
        "exec": "playerctl --follow metadata --format '{{ artist }} – {{ title }}' 2>/dev/null",
        "format": "󰎇  {}",
        "max-length": 45,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "custom/media-next": {
        "exec": "playerctl status >/dev/null 2>&1 && echo '󰒭'",
        "interval": 2,
        "tooltip": false,
        "on-click": "playerctl next"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/nextevent": {
        "exec": "$HOME/.local/bin/nextevent",
        "return-type": "json",
        "interval": 60,
        "on-click": "kitty --class calendar -e ikhal"
    },
    "custom/pomo": {
        "exec": "$HOME/.local/bin/pomo status",
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.local/bin/pomo toggle",
        "on-click-right": "$HOME/.local/bin/pomo menu",
        "on-click-middle": "$HOME/.local/bin/pomo reset"
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "backlight/slider": {
        "min": 1,
        "max": 100,
        "orientation": "horizontal"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "tooltip-format": "{controller_alias}  {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀  wired",
        "format-disconnected": "󰖪  offline",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}",
	"on-click": "$HOME/.local/bin/power-menu"
    },
  "custom/remind": {
        "format": "󰂚",
        "tooltip-format": "New reminder",
        "on-click": "$HOME/.local/bin/remind",
        "on-click-right": "$HOME/.local/bin/remind list"
    },

    "tray": {
        "spacing": 8
    }
}
