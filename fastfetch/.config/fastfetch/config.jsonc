{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/cross.txt",
        "color": {
            "1": "38;2;216;166;87",
            "2": "38;2;169;182;101",
            "3": "38;2;180;113;9"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;169;182;101",
            "title": "38;2;216;166;87"
        },
        "key": {
            "width": 14
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user": "38;2;216;166;87",
                "at": "38;2;146;131;116",
                "host": "38;2;216;166;87"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;146;131;116m────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰣇  os"
        },
        {
            "type": "kernel",
            "key": "  kernel"
        },
        {
            "type": "wm",
            "key": "  wm"
        },
        {
            "type": "terminal",
            "key": "  terminal"
        },
        {
            "type": "shell",
            "key": "  shell"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;146;131;116m────────────────────────────────"
        },
        {
            "type": "cpu",
            "key": "󰻠  cpu"
        },
        {
            "type": "gpu",
            "key": "󰍹  gpu"
        },
        {
            "type": "memory",
            "key": "󰍛  memory"
        },
        {
            "type": "disk",
            "key": "󰋊  disk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "󰁹  battery"
        },
        {
            "type": "uptime",
            "key": "󰅐  uptime"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
